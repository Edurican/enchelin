# ============================================================
# Enchelin 환경변수
# 이 파일을 복사하여 .env를 생성하세요. .env는 절대 커밋 금지.
# ============================================================

# === Frontend =================================================

# 카카오 JavaScript 키 (브라우저 지도 SDK용)
# 발급: https://developers.kakao.com > 앱 키 > JavaScript 키
VITE_KAKAO_JS_KEY=your-kakao-javascript-key

# === Backend ==================================================

# -- JWT -------------------------------------------------------
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRATION=3600000

# -- GitHub OAuth ----------------------------------------------
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# -- Kakao REST API (서버 전용, 프론트엔드 노출 금지) ----------
# 발급: https://developers.kakao.com > 앱 키 > REST API 키
KAKAO_API_KEY=your-kakao-rest-api-key

# -- Anthropic Claude API (AI 리뷰 요약) ----------------------
# 발급: https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key

# === Database =================================================

DB_URL=jdbc:postgresql://localhost:5432/enchelin
DB_USERNAME=postgres
DB_PASSWORD=your-db-password

# === App / Deploy =============================================

# 프론트엔드 URL (CORS, 리다이렉트 등)
APP_FRONTEND_URL=http://localhost:5173

# 백엔드 베이스 URL (GitHub OAuth redirect-uri에 사용)
# 로컬: http://localhost:8080 / Railway: https://your-app.railway.app
APP_BASE_URL=http://localhost:8080

# Spring 프로필 (로컬: local / 배포: prod)
SPRING_PROFILES_ACTIVE=local